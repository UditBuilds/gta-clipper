       {"file": "rockstar/GTAVI_Videos/Lucia_Caminos_Video_Clip.mp4", "focus": "center"}],
     "green": ["212 GIGS"], "red": []},
    {"say": "If you saw November 12, that's old. Rockstar moved pre-load up to November 10.",
     "visuals": [
       {"file": "rockstar/GTAVI_Screenshots/Places/Vice City/Vice_City_16.jpg", "focus": [0.64, 0.45]},
       {"file": "rockstar/GTAVI_Artwork_Wallpapers/Jason_and_Lucia_01/Jason_and_Lucia_01_landscape.jpg", "focus": [0.48, 0.15]},
       {"card": "~NOV 12~|*NOV 10*", "weight": 1.3}],
     "green": ["NOVEMBER 10"], "red": ["NOVEMBER 12"]},
    {"say": "On PS5, it opens at midnight, your local time.",
     "visuals": [
       {"file": "rockstar/GTAVI_Screenshots/Places/Vice City/Vice_City_22.jpg", "focus": 0.75},
       {"card": "*NOV 10*|12 AM LOCAL"}],
     "green": ["LOCAL TIME"], "red": []},
    {"say": "On Xbox, it's midnight GMT, for everyone at once.",
     "visuals": [
       {"file": "rockstar/GTAVI_Screenshots/Places/Vice City/Vice_City_27.jpg", "pan": "right", "weight": 2},
       {"file": "rockstar/GTAVI_Screenshots/Places/Vice City/Vice_City_13.jpg", "focus": "center"}],
     "green": ["MIDNIGHT GMT"], "red": []},
    {"say": "Code-in-box copies land November 12, so you can pre-load those too.",
     "visuals": [
       {"file": "rockstar/GTAVI_Artwork_Wallpapers/Official_Cover_Art/Official_Cover_Art_phone.jpg", "focus": "center", "weight": 1.2},
       {"file": "rockstar/GTAVI_Screenshots/People/Lucia Caminos/Lucia_Caminos_02.jpg", "focus": [0.46, 0.4]},
       {"file": "rockstar/GTAVI_Screenshots/People/Jason and Lucia/Jason_and_Lucia_02.jpg", "focus": [0.43, 0.2]}],
     "green": ["CODE-IN-BOX"], "red": []},
    {"say": "But pre-loading doesn't let you play early. The game unlocks at midnight on November 19, in your time zone. New Zealand gets it first.",
     "visuals": [
       {"file": "rockstar/GTAVI_Screenshots/People/Jason Duval/Jason_Duval_07.jpg", "focus": [0.52, 0.35], "weight": 1.5},
       {"file": "rockstar/GTAVI_Screenshots/Places/Vice City/Vice_City_08.jpg", "pan": "left", "weight": 2.2},
       {"card": "*NOV 19*|12 AM", "weight": 1.5},
       {"file": "rockstar/GTAVI_Videos/Jason_Duval_Video_Clip.mp4", "at": "0.3", "focus": 0.7, "weight": 1.05},
       {"file": "rockstar/GTAVI_Screenshots/People/Jason and Lucia/Jason_and_Lucia_16.jpg", "focus": 0.35, "weight": 1.6}],
     "green": ["NOVEMBER 19"], "red": ["PLAY EARLY"]},
    {"say": "So clear the space this weekend, turn on auto-download, and let it run.",
     "visuals": [
       {"file": "rockstar/GTAVI_Screenshots/Places/Leonida Keys/Leonida_Keys_05.jpg", "focus": 0.7},
