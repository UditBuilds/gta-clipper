  "lines": [
    {"say": "GTA 6 needs up to 212 gigs on PS5. And you can start downloading it on Tuesday.",
     "visuals": [
       {"file": "rockstar/GTAVI_Screenshots/People/Jason and Lucia/Jason_and_Lucia_01.jpg", "focus": [0.36, 0.4]},
       {"card": "212 GB"},
